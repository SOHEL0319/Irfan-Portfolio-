# ==============================================================================
# Environment Variables Template for Mahammad Irfan Shaik Portfolio
# Copy this file to .env for local development or set in Vercel Project Settings
# ==============================================================================

# Optional: GitHub Personal Access Token for higher API rate limits (5,000 req/hr vs 60 req/hr)
# Do NOT prefix with public/exposed prefixes.
GITHUB_TOKEN=

# Optional: Secret used to verify GitHub Push Webhooks on /api/github-webhook
GITHUB_WEBHOOK_SECRET=
